{
  "name": "@cplieger/ui",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./signal": "./src/signal/index.ts",
    "./dom": "./src/dom/index.ts",
    "./fetch": "./src/fetch/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint:stylelint": "stylelint \"css/**/*.css\"",
    "lint:knip": "knip",
    "lint:fix": "eslint . --fix && prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "knip": "6.44.1",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "overrides": {
    "qs": "^6.15.2",
    "minimatch": "^11.0.1"
  },
  "files": [
    "src/",
    "jsr.json",
    "!src/**/*.test.ts",
    "!src/**/*-setup.ts",
    "!src/**/test-helpers/**"
  ],
  "description": "Build framework-free TypeScript browser UIs with signals, accessible widgets, typed requests and server actions",
  "license": "Apache-2.0",
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cplieger/ui.git"
  },
  "homepage": "https://github.com/cplieger/ui",
  "bugs": {
    "url": "https://github.com/cplieger/ui/issues"
  },
  "author": "cplieger <917744+cplieger@users.noreply.github.com>"
}
