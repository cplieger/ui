{
  "name": "@cplieger/ui",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./active-filters": "./src/data/active-filters/active-filters.ts",
    "./anchor": "./src/overlays/anchor/anchor.ts",
    "./announce": "./src/feedback/announce/announce.ts",
    "./ask": "./src/overlays/ask/ask.ts",
    "./chart": "./src/data/chart/chart.ts",
    "./checkbox": "./src/forms/checkbox/checkbox.ts",
    "./chip": "./src/feedback/chip/chip.ts",
    "./choice": "./src/forms/choice/choice.ts",
    "./combobox": "./src/forms/combobox/combobox.ts",
    "./confirm": "./src/buttons/confirm/confirm.ts",
    "./connection-test": "./src/forms/connection-test/connection-test.ts",
    "./context-panel": "./src/layout/context-panel/context-panel.ts",
    "./copy": "./src/forms/copy/copy.ts",
    "./date-range": "./src/forms/date-range/date-range.ts",
    "./dialog": "./src/overlays/dialog/dialog.ts",
    "./disclosure": "./src/navigation/disclosure/disclosure.ts",
    "./feed": "./src/data/feed/feed.ts",
    "./file": "./src/forms/file/file.ts",
    "./form": "./src/forms/form/form.ts",
    "./held-list": "./src/data/held-list/held-list.ts",
    "./highlight": "./src/content/highlight/highlight.ts",
    "./icons": "./src/foundations/icons/icons.ts",
    "./keyed-list": "./src/data/keyed-list/keyed-list.ts",
    "./list-detail": "./src/layout/list-detail/list-detail.ts",
    "./list-row": "./src/data/list-row/list-row.ts",
    "./markdown": "./src/content/markdown/markdown.ts",
    "./menu": "./src/overlays/menu/menu.ts",
    "./meter": "./src/data/meter/meter.ts",
    "./overflow": "./src/buttons/overflow/overflow.ts",
    "./pairs": "./src/forms/pairs/pairs.ts",
    "./palette": "./src/overlays/palette/palette.ts",
    "./panel": "./src/overlays/panel/panel.ts",
    "./pill": "./src/core/pill/pill.ts",
    "./pointer": "./src/core/pointer/pointer.ts",
    "./popconfirm": "./src/overlays/popconfirm/popconfirm.ts",
    "./press": "./src/core/press/press.ts",
    "./radio-focus": "./src/core/radio-focus/radio-focus.ts",
    "./range": "./src/forms/range/range.ts",
    "./ranked-bars": "./src/data/ranked-bars/ranked-bars.ts",
    "./relative-time": "./src/data/relative-time/relative-time.ts",
    "./reorder": "./src/data/reorder/reorder.ts",
    "./roll": "./src/core/roll/roll.ts",
    "./roving-focus": "./src/core/roving-focus/roving-focus.ts",
    "./rules": "./src/forms/rules/rules.ts",
    "./search": "./src/forms/search/search.ts",
    "./secret": "./src/forms/secret/secret.ts",
    "./select-panel": "./src/overlays/select-panel/select-panel.ts",
    "./share-bar": "./src/data/share-bar/share-bar.ts",
    "./skeleton": "./src/feedback/skeleton/skeleton.ts",
    "./sparkline": "./src/data/sparkline/sparkline.ts",
    "./state-history": "./src/data/state-history/state-history.ts",
    "./stepper": "./src/forms/stepper/stepper.ts",
    "./table": "./src/data/table/table.ts",
    "./tabs": "./src/navigation/tabs/tabs.ts",
    "./textarea": "./src/forms/textarea/textarea.ts",
    "./theme": "./src/core/theme/theme.ts",
    "./toast": "./src/feedback/toast/toast.ts",
    "./toggle": "./src/buttons/toggle/toggle.ts",
    "./tokens": "./src/forms/tokens/tokens.ts",
    "./tooltip": "./src/overlays/tooltip/tooltip.ts",
    "./turn": "./src/buttons/turn/turn.ts",
    "./view-transition": "./src/core/view-transition/view-transition.ts",
    "./icons/svg/*": "./icons/svg/*",
    "./icons/marks/*": "./icons/marks/*",
    "./fonts/*": "./fonts/*",
    "./css/system": "./css/system.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p gallery/tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "icons:sync": "ICONS_SYNC=1 vitest --run --project node src/foundations/icons/icons.node.test.ts",
    "system:sync": "SYSTEM_SYNC=1 vitest --run --project node src/system/system-css.node.test.ts",
    "system:screens": "SYSTEM_SCREENS=1 vitest --run --project node src/system/system-screens.node.test.ts",
    "gallery": "node gallery/build.ts",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint:stylelint": "stylelint \"css/**/*.css\" \"src/**/*.css\"",
    "lint:knip": "knip",
    "lint:fix": "eslint . --fix && prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "knip": "6.44.2",
    "lucide-static": "1.68.0",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "rolldown": "1.3.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "qs": "^6.15.2",
    "minimatch": "^11.0.1"
  },
  "files": [
    "src/",
    "css/",
    "icons/",
    "fonts/",
    "jsr.json",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "!src/**/*.test.ts",
    "!src/**/*.css",
    "!src/**/*.txt",
    "!src/**/*-setup.ts",
    "!src/**/test-helpers/**"
  ],
  "description": "A design language and the components built on it, for browser apps that draw their interface with plain HTML and DOM code",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cplieger/ui.git"
  },
  "homepage": "https://github.com/cplieger/ui",
  "bugs": {
    "url": "https://github.com/cplieger/ui/issues"
  },
  "author": "cplieger <917744+cplieger@users.noreply.github.com>",
  "cplieger": {
    "browsers": [
      "chromium",
      "firefox",
      "webkit"
    ]
  }
}
