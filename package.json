{
  "name": "@cplieger/ui",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/primitives/announce.ts",
    "./src/primitives/ask.ts",
    "./src/primitives/dialog-engine.ts",
    "./src/primitives/dialog.ts",
    "./src/primitives/modal-host.ts",
    "./src/primitives/modal.ts",
    "./src/primitives/popover.ts",
    "./src/primitives/popup-core.ts",
    "./src/primitives/popup.ts",
    "./src/primitives/toast/index.ts",
    "./src/primitives/toast/view.ts",
    "./src/primitives/tooltip.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./signal": "./src/signal/index.ts",
    "./dom": "./src/dom/index.ts",
    "./fetch": "./src/fetch/index.ts",
    "./actions": "./src/actions/index.ts",
    "./actions/testing": "./src/actions/testing.ts",
    "./toast": "./src/primitives/toast/index.ts",
    "./tooltip": "./src/primitives/tooltip.ts",
    "./popover": "./src/primitives/popover.ts",
    "./popup": "./src/primitives/popup.ts",
    "./dialog": "./src/primitives/dialog.ts",
    "./modal": "./src/primitives/modal.ts",
    "./ask": "./src/primitives/ask.ts",
    "./connection-test": "./src/primitives/connection-test.ts",
    "./disclosure": "./src/primitives/disclosure.ts",
    "./focus-trap": "./src/primitives/focus-trap.ts",
    "./roving-focus": "./src/primitives/roving-focus.ts",
    "./skeleton": "./src/primitives/skeleton.ts",
    "./theme": "./src/primitives/theme.ts",
    "./view-transition": "./src/primitives/view-transition.ts",
    "./transition": "./src/primitives/transition.ts",
    "./announce": "./src/primitives/announce.ts",
    "./icons": "./src/primitives/icons.ts",
    "./icons/svg/*": "./icons/svg/*",
    "./css": "./css/ui-primitives.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "icons:sync": "ICONS_SYNC=1 vitest --run --project node src/primitives/icons.node.test.ts",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint:stylelint": "stylelint \"css/**/*.css\"",
    "lint:knip": "knip",
    "lint:fix": "eslint . --fix && prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "knip": "6.44.1",
    "lucide-static": "1.68.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "rolldown": "1.2.16",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "qs": "^6.15.2",
    "minimatch": "^11.0.1"
  },
  "files": [
    "src/",
    "css/",
    "icons/",
    "jsr.json",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "!src/**/*.test.ts",
    "!src/**/*-setup.ts",
    "!src/**/test-helpers/**"
  ],
  "description": "Build framework-free TypeScript browser UIs with signals, accessible widgets, typed requests and server actions",
  "license": "Apache-2.0",
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cplieger/ui.git"
  },
  "homepage": "https://github.com/cplieger/ui",
  "bugs": {
    "url": "https://github.com/cplieger/ui/issues"
  },
  "author": "cplieger <917744+cplieger@users.noreply.github.com>"
}
