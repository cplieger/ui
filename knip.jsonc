{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // A suppression added here that stops matching fails the gate instead of going stale.
  "treatConfigHintsAsErrors": true,
  // The gallery builds from main.ts and frame.ts through esbuild, which knip does not follow.
  "entry": ["gallery/main.ts", "gallery/frame.ts"],
  // cycles is knip's one warn-level issue type: without this it prints and exits 0.
  "rules": { "cycles": "error" },
}
