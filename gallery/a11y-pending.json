[
  {
    "rule": "color-contrast",
    "pages": ["layouts"],
    "selector": ".f-box > small",
    "engines": ["chromium", "firefox", "webkit"],
    "states": ["light 1440", "light 390"],
    "element": "layouts page boxes"
  },
  {
    "rule": "color-contrast-enhanced",
    "pages": [
      "buttons",
      "charts",
      "content",
      "data",
      "feedback",
      "forms",
      "index",
      "layouts",
      "media",
      "messages",
      "navigation",
      "not-found",
      "overlays",
      "scope",
      "search",
      "settings",
      "setup",
      "sign-in"
    ],
    "selector": ".controls select",
    "engines": ["chromium"],
    "states": ["dark 1440 more contrast"],
    "element": "gallery controls"
  },
  {
    "rule": "color-contrast-enhanced",
    "pages": ["layouts"],
    "selector": ":is(.f-box, .f-detail) > small",
    "engines": ["chromium", "firefox", "webkit"],
    "states": ["dark 1440 more contrast", "light 1440 more contrast"],
    "element": "layouts page boxes"
  },
  {
    "rule": "color-contrast-enhanced",
    "pages": ["docs/system/parts"],
    "selector": "[data-cp-confirm] > .cp-roll",
    "engines": ["chromium", "firefox", "webkit"],
    "states": ["dark 1440 more contrast"],
    "element": "buttons/confirm"
  },
  {
    "rule": "focus-order-semantics",
    "pages": ["data"],
    "selector": ".cp-truncate[tabindex=\"0\"]",
    "engines": ["chromium", "firefox", "webkit"],
    "states": ["dark 1440", "dark 390", "light 1440", "light 390"],
    "element": "data/list-row"
  },
  {
    "rule": "heading-order",
    "pages": ["search"],
    "selector": ".g-result > h3",
    "engines": ["chromium", "firefox", "webkit"],
    "states": ["dark 1440", "dark 390", "light 1440", "light 390"],
    "element": "search screen"
  },
  {
    "rule": "heading-order",
    "pages": ["content"],
    "selector": ":is([data-level=\"4\"], #md-live-out) > h4",
    "engines": ["chromium", "firefox", "webkit"],
    "states": ["dark 1440", "dark 390", "light 1440", "light 390"],
    "element": "content/markdown"
  },
  {
    "rule": "identical-links-same-purpose",
    "pages": ["navigation"],
    "selector": ".g-mini-header a[href=\"#frame\"]",
    "engines": ["chromium", "firefox", "webkit"],
    "states": ["dark 1440", "dark 390", "light 1440", "light 390"],
    "element": "navigation header card"
  },
  {
    "rule": "label-content-name-mismatch",
    "pages": ["navigation"],
    "selector": ".cp-account",
    "engines": ["chromium", "firefox", "webkit"],
    "states": ["dark 1440", "dark 390", "light 1440", "light 390"],
    "element": "navigation/account"
  },
  {
    "rule": "label-content-name-mismatch",
    "pages": ["forms"],
    "selector": "[role=\"option\"][aria-label]",
    "engines": ["chromium", "firefox", "webkit"],
    "states": [
      "dark 1440 overlay #f-langs-list open",
      "dark 1440 overlay #f-tags-list open",
      "light 1440 overlay #f-langs-list open",
      "light 1440 overlay #f-tags-list open"
    ],
    "element": "forms/combobox"
  },
  {
    "rule": "label-content-name-mismatch",
    "pages": ["overlays"],
    "selector": "button[popovertarget=\"p-filters\"]",
    "engines": ["chromium", "firefox", "webkit"],
    "states": ["dark 1440", "dark 390", "light 1440", "light 390"],
    "element": "forms/choice"
  },
  {
    "rule": "landmark-unique",
    "pages": ["navigation"],
    "selector": ".cp-crumbs",
    "engines": ["chromium", "firefox", "webkit"],
    "states": ["dark 1440", "dark 390", "light 1440", "light 390"],
    "element": "navigation/breadcrumbs"
  },
  {
    "rule": "landmark-unique",
    "pages": ["navigation"],
    "selector": ".g-header",
    "engines": ["chromium", "firefox", "webkit"],
    "states": ["dark 1440", "dark 390", "light 1440", "light 390"],
    "element": "gallery page header"
  },
  {
    "rule": "landmark-unique",
    "pages": ["navigation"],
    "selector": ".g-mini-header nav[aria-label=\"Main\"]",
    "engines": ["chromium", "firefox", "webkit"],
    "states": ["dark 1440", "dark 390", "light 1440", "light 390"],
    "element": "navigation header card"
  },
  {
    "rule": "landmark-unique",
    "pages": ["forms", "index", "navigation"],
    "selector": "main.play, body > main",
    "engines": ["chromium", "firefox", "webkit"],
    "states": ["dark 1440", "dark 390", "light 1440", "light 390"],
    "element": "gallery page main"
  },
  {
    "rule": "region",
    "pages": [
      "buttons",
      "charts",
      "content",
      "data",
      "feedback",
      "forms",
      "index",
      "layouts",
      "media",
      "messages",
      "navigation",
      "not-found",
      "overlays",
      "scope",
      "search",
      "settings",
      "setup",
      "sign-in"
    ],
    "selector": ".controls",
    "engines": ["chromium", "firefox", "webkit"],
    "states": ["dark 1440", "dark 390", "light 1440", "light 390"],
    "element": "gallery controls"
  },
  {
    "rule": "scrollable-region-focusable",
    "pages": ["index"],
    "selector": ".g-ladders",
    "engines": ["chromium", "firefox", "webkit"],
    "states": ["dark 390", "light 390"],
    "element": "gallery index ladders"
  },
  {
    "rule": "target-size",
    "pages": [
      "buttons",
      "charts",
      "content",
      "data",
      "feedback",
      "forms",
      "index",
      "layouts",
      "media",
      "messages",
      "navigation",
      "not-found",
      "overlays",
      "scope",
      "search",
      "settings",
      "setup",
      "sign-in"
    ],
    "selector": ".controls :is(input, select)",
    "engines": ["chromium", "firefox"],
    "states": ["dark 390", "light 390"],
    "element": "gallery controls"
  },
  {
    "rule": "target-size",
    "pages": ["messages"],
    "selector": ".cp-context-panel li > a",
    "engines": ["chromium", "firefox", "webkit"],
    "states": ["dark 1440", "light 1440"],
    "element": "layout/context-panel"
  },
  {
    "rule": "target-size",
    "pages": ["data"],
    "selector": ".cp-list-row[data-lines=\"wrap\"] details > summary",
    "engines": ["chromium", "firefox", "webkit"],
    "states": ["dark 1440", "light 1440", "light 1440 details open"],
    "element": "data/feed"
  },
  {
    "rule": "target-size",
    "pages": ["docs/system/parts"],
    "selector": ".cp-notice li > a",
    "engines": ["chromium", "firefox", "webkit"],
    "states": ["dark 1440", "dark 390", "light 1440", "light 390"],
    "element": "feedback/notice"
  }
]
